# Secrets (set in Cloudflare with `wrangler secret put NAME`; this file is only read by relay/scripts/*.mjs locally)
TOKENROUTER_MASTER_KEY=            # sk-... used only in forwarding (relay) mode
TOKENROUTER_MANAGEMENT_KEY=        # caps and disables pool keys (preferred key mode)
HMAC_SECRET=                       # 32 random bytes, hex
ADMIN_SECRET=                      # for /api/admin/*
RESEND_API_KEY=
ALERT_EMAIL=
# Non-secret vars live in wrangler.toml. For scripts:
PUBLIC_BASE_URL=https://routearena-api.workers.dev
TOKENROUTER_BASE_URL=https://api.tokenrouter.com
PER_CLAIM_USD=1

# Sender on your verified Resend domain, e.g. "RouteArena <hello@mail.yourdomain>" (Worker secret; defaults to Resend's test sender)
MAIL_FROM=
