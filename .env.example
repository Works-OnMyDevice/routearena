TOGETHER_API_KEY=
GROQ_API_KEY=
DEEPINFRA_API_KEY=
FIREWORKS_API_KEY=
# Optional: OpenRouter management key for `replay --from-api`
OPENROUTER_MANAGEMENT_KEY=
